# Execute — environment variables this repo reads
#
# Copy to `.env` and fill in what you need. NOTHING here is required to run the gates or most
# skills; every entry is either optional or scoped to one tool, and each says what breaks without it.
#
# NEVER commit a filled-in .env. Secrets belong in your environment configuration, never in the
# repo and never pasted into a chat transcript. `security-gate` fails the push on a tracked .env or
# a hardcoded secret.
#
# Produced by scanning every process.env read outside node_modules and vendored skill-library code.
# `system-design-gate` fails the push when code reads a non-public env var and this file does not
# document it — so when you add a new one, add it here in the same commit.

# --- model / API keys (all optional; the tool that needs one says so when it is absent) ---------
OPENAI_API_KEY=            # skills/second-opinion — an independent code review from a non-Anthropic
                           # model. Needs real API credit. Without it the skill reports NOT CHECKED.

# --- the design loop's third leg ----------------------------------------------------------------
# Any OpenAI-compatible VISION endpoint: a free provider directly, or a router in front of several.
# WITHOUT THESE leg 3 is NOT CHECKED, which is never a pass — but it is not blocking either:
# judge-frames.mjs runs the same check through a fresh sub-agent with no credential. An external
# model is still the stronger evaluator, because a sub-agent shares a model family with whatever
# wrote the code.
VISION_JUDGE_URL=          # chat/completions endpoint
VISION_JUDGE_MODEL=        # a vision-capable model id available on that endpoint
VISION_JUDGE_KEY=          # the API key

# --- tools ---------------------------------------------------------------------------------------
FIRECRAWL_API_KEY=         # skills/crawl-site — optional; the crawler is keyless by default.
SEMGREP_RULES=             # skills/security-gate — rule set for semgrep when it is installed.
EXECUTE_ROOT=              # skills/security-gate — overrides repo-root detection. Rarely needed.

# --- browser / visual QA --------------------------------------------------------------------------
PW_CHROMIUM=               # explicit Chromium path if the bundled one is not found.
PLAYWRIGHT_FROM=           # module to resolve playwright from, for the vendored verifier.
AXE=                       # set to 0 to skip the axe-core accessibility sweep. Do not, casually.
VQA_BASE=                  # base URL for a visual-qa sweep against something already running.
VQA_CONCURRENCY=           # parallel pages in the sweep. Default is fine.
VQA_PIXEL_TOLERANCE=       # per-channel tolerance for baseline diffing. Default is fine.

# --- your own projects ----------------------------------------------------------------------------
# Anything under projects/ adds its own variables here as you build. Keep the rule the gate enforces:
# a variable the code reads is a variable this file documents, and a `TODO(keys)` marker pairs with a
# row in SETUP-KEYS.md. Publishable values (the EXPO_PUBLIC_ / NEXT_PUBLIC_ prefixes are the tell)
# are safe to expose; everything else is a secret and belongs only in your environment config.
