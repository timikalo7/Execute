# career-agent — every environment variable the scripts read. ALL are optional.
# Copy to .env only if you want to change a default; .env is gitignored. No API keys are needed:
# the optional job-search keys at the end only add more postings. Never commit a real key.
# The scripts read these from the environment (they do not load .env themselves), so either export
# them in your shell or prefix a command, e.g.  CAREER_AGENT_CONTACT=you@example.com npm run discover

# Contact string sent in the User-Agent header to the public job-board APIs discover.mjs calls.
# Default when unset: "career-agent (personal job search)". Put an email here only if you are happy
# for every job board the tool queries to see it.
CAREER_AGENT_CONTACT=

# Path to the profile the scripts read. Default: profile/master-profile.json
CAREER_AGENT_PROFILE=

# Which browser makes PDFs and fills forms: msedge, chrome, or chromium (Playwright's own build only).
# Default when unset: the installed browser first (Windows: Edge, then Chrome; macOS: Chrome, then
# Edge; Linux: Chrome), and Playwright's own Chromium last, if `npx playwright install chromium` ran.
CAREER_AGENT_BROWSER=

# Path to a Chrome or Chromium program, tried before anything else (for example on a locked-down
# machine where Chrome is installed somewhere unusual). Default: unset.
CAREER_AGENT_CHROMIUM=

# Self-tests only: fixed ports for the local fixture server and the attach (CDP) test, instead of a
# free port picked by the OS. Leave empty unless something else on your machine needs the ports.
CAREER_AGENT_TEST_PORT=
CAREER_AGENT_CDP_PORT=

# --- More jobs (optional). With none of these set, discover works exactly as before and prints one
# "not configured" line per source, with no network call. Keys are read from the environment only;
# the tool never prints them or writes them to a file. Each source makes at most 10 searches a run
# (your target.roles x target.locations), in the UK.

# Adzuna: official job-search API. Free key: https://developer.adzuna.com/signup  (set both)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reed: official jobseeker API. Free key: https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# Apify: OPT-IN. Runs third-party scrapers of LinkedIn and Indeed jobs on YOUR Apify account.
# LinkedIn's and Indeed's terms of use forbid scraping their sites: decide for yourself whether to use
# it. Each run uses your Apify credit. Token: https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Which Apify actors run, as username~actor-name. Defaults: valig~linkedin-jobs-scraper and
# valig~indeed-jobs-scraper. Another actor must take the same input and give the same fields.
CAREER_AGENT_APIFY_LINKEDIN_ACTOR=
CAREER_AGENT_APIFY_INDEED_ACTOR=
